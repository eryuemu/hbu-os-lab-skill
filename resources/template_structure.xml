    <w:tc><w:tcPr><w:tcW w:w="1920" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr>
      <w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="21"/></w:rPr><w:t>实验总结与反思</w:t></w:r></w:p>
    </w:tc>
    <w:tc><w:tcPr><w:tcW w:w="6960" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr>
      <!-- {{SUMMARY_AND_REFLECTION}} -->
    </w:tc>
