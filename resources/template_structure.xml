    <w:tc><w:tcPr><w:tcW w:w="6960" w:type="dxa"/><w:vAlign w:val="top"/></w:tcPr>
      <!-- {{DETAILED_CONTENT_AND_SUB_TABLES_AND_IMAGES}} -->
